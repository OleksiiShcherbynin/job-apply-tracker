# Copy to .env (git-ignored). Read by the `web` service in docker-compose.yml.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,job-apply-tracker
# The laptop container serves plain HTTP on localhost.
DJANGO_HTTPS=0
POSTGRES_USER=tracker
POSTGRES_PASSWORD=devpass
